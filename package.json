{
	"name": "ambulance-dispatch-prototype-config-adapter",
	"private": true,
	"packageManager": "pnpm@10.30.3",
	"scripts": {
		"prepare": "husky config/husky",
		"changeset": "pnpm exec changeset",
		"changeset:status": "pnpm exec changeset status",
		"version-packages": "pnpm exec changeset version",
		"dev": "pnpm --dir config run dev",
		"build": "pnpm --dir config run build",
		"test": "pnpm --dir config run test",
		"quality": "node \"$(git rev-parse --show-toplevel)/scripts/quality-runner.mjs\" quality",
		"quality:all": "node \"$(git rev-parse --show-toplevel)/scripts/quality-runner.mjs\" quality --all",
		"verify": "pnpm run quality:all && pnpm run test && pnpm run build"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@changesets/cli": "3.0.3",
		"@terra-symposium/standards-quality": "2.3.7",
		"@types/react": "^19.2.18",
		"astro": "^7.4.7",
		"husky": "9.1.7",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^1.1.2",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@astrojs/react": "^6.0.4",
		"react": "19.2.7"
	},
	"peerDependencies": {
		"@types/react-dom": "^19.3.0",
		"react-dom": "19.2.7"
	}
}
