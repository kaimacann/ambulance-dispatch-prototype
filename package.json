{
	"name": "ambulance-dispatch-prototype-config-adapter",
	"private": true,
	"packageManager": "pnpm@10.30.3",
	"scripts": {
		"dev": "pnpm --dir config run dev",
		"build": "pnpm --dir config run build",
		"test": "pnpm --dir config run test",
		"check": "astro check --config astro.config.mjs --tsconfig config/tsconfig.json",
		"quality": "pnpm --dir config run quality",
		"quality:all": "pnpm --dir config run quality:all",
		"format:check": "pnpm --dir config run format:check",
		"lint": "pnpm --dir config run lint",
		"knip": "pnpm --dir config run knip"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@terra-symposium/standards-quality": "2.2.0",
		"@types/react": "^19.2.18",
		"astro": "^7.4.7",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@astrojs/react": "^6.0.4",
		"react": "19.2.7"
	},
	"peerDependencies": {
		"@types/react-dom": "^19.3.0",
		"react-dom": "19.2.7"
	}
}
