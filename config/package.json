{
	"name": "gp-triage-demo",
	"version": "1.0.0",
	"private": false,
	"type": "module",
	"packageManager": "pnpm@10.30.3",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"quality:fix-boundaries": "node scripts/quality.mjs error-boundaries --all",
		"dev": "cd .. && mkdir -p dist/cache/astro-types && pnpm exec astro dev --config config/astro.config.mjs",
		"build": "cd .. && mkdir -p dist/cache/astro-types && pnpm exec astro build --config config/astro.config.mjs",
		"check": "cd .. && pnpm run check",
		"quality": "node \"$(git rev-parse --show-toplevel)/scripts/quality-runner.mjs\" quality",
		"quality:all": "node \"$(git rev-parse --show-toplevel)/scripts/quality-runner.mjs\" quality --all",
		"test": "cd .. && node --test tests/*.test.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@typescript-eslint/eslint-plugin": "^8.71.0",
		"@typescript-eslint/parser": "^8.71.0",
		"autoprefixer": "^10.5.4",
		"eslint": "^10.11.0",
		"eslint-plugin-astro": "^3.2.1",
		"globals": "^17.13.0",
		"knip": "^6.39.0",
		"postcss": "^8.5.26",
		"tailwindcss": "^3.4.19"
	}
}
