{
	"name": "gp-triage-demo",
	"version": "1.0.0",
	"private": false,
	"type": "module",
	"packageManager": "pnpm@10.30.3",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"dev": "cd .. && pnpm exec astro dev --config astro.config.mjs",
		"build": "cd .. && node scripts/quality.mjs error-boundaries --all && pnpm exec astro build --config astro.config.mjs",
		"check": "cd .. && pnpm run check",
		"quality": "cd .. && node scripts/quality.mjs quality",
		"quality:all": "cd .. && node scripts/quality.mjs quality --all",
		"format:check": "cd .. && prettier --check . --config config/.prettierrc.mjs --ignore-path .gitignore --ignore-path config/.prettierignore",
		"lint": "cd .. && eslint . --config config/eslint.config.mjs",
		"knip": "cd .. && knip --config config/knip.json"
	},
	"dependencies": {},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@typescript-eslint/eslint-plugin": "^8.71.0",
		"@typescript-eslint/parser": "^8.71.0",
		"autoprefixer": "^10.5.4",
		"eslint": "^10.11.0",
		"eslint-plugin-astro": "^3.2.1",
		"globals": "^17.13.0",
		"knip": "^6.39.0",
		"postcss": "^8.5.26",
		"prettier": "^3.9.9",
		"tailwindcss": "^3.4.19"
	}
}
