{
	"$schema": "../node_modules/@terra-symposium/quality/quality.schema.json",
	"sourceRoots": ["src"],
	"tsconfig": "config/tsconfig.json",
	"extensions": [".astro", ".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"],
	"enabledChecks": {
		"format": false,
		"lint": false,
		"knip": false,
		"type": true,
		"recommend": true,
		"name": true,
		"alias": true
	},
	"qualityCommands": [
		{
			"name": "format",
			"command": "pnpm",
			"args": ["run", "format:check"]
		},
		{
			"name": "lint",
			"command": "pnpm",
			"args": ["run", "lint"]
		},
		{
			"name": "knip",
			"command": "pnpm",
			"args": ["run", "knip"]
		},
		{
			"name": "check",
			"command": "pnpm",
			"args": ["run", "check"]
		},
		{
			"name": "build",
			"command": "pnpm",
			"args": ["run", "build"]
		}
	],
	"documentation": {
		"required": {
			"types": true,
			"functions": true,
			"exportedFunctions": true,
			"noInlineFunctions": false
		}
	},
	"protectedIdentifiers": [
		"current",
		"value",
		"previous",
		"symptom",
		"score",
		"id",
		"item",
		"field",
		"event",
		"index",
		"error",
		"nextCopies",
		"DashboardRecord",
		"shareMessage",
		"setShareMessage",
		"currentDashboard",
		"board",
		"records",
		"requestedId",
		"response",
		"message",
		"imageTheme",
		"channel",
		"left",
		"right",
		"errors",
		"values",
		"name",
		"props",
		"children",
		"duration",
		"delay",
		"patient",
		"scoreTotal",
		"reverse",
		"rows",
		"className",
		"src",
		"poster",
		"title",
		"author",
		"meta",
		"alt",
		"origin",
		"terminus",
		"nodeData",
		"setSelectedNode",
		"PlayerProps",
		"AudioTrack",
		"MarqueeComponentProps",
		"Person",
		"SaibaiFlowNode",
		"SaibaiButtonProps",
		"AudioCtrlsProps",
		"CarbonIconName",
		"MapGeography",
		"Props",
		"State",
		"ButtonProps",
		"PersonNodeData",
		"PersonGraphNode",
		"MarriageGraphNode",
		"GenealogyNode",
		"PatientFormData",
		"PatientRec",
		"fieldKey",
		"fieldType",
		"fieldPlaceholder",
		"description"
	],
	"tools": {
		"prettier": "prettier",
		"eslint": "eslint",
		"knip": "knip",
		"tsc": "tsc"
	},
	"root": ".."
}
