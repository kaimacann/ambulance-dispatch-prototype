{
	"$schema": "../node_modules/@terra-symposium/standards-quality/quality.schema.json",
	"sourceRoots": ["."],
	"tsconfig": "config/tsconfig.json",
	"extensions": [
		".astro",
		".c",
		".cjs",
		".cpp",
		".cts",
		".css",
		".h",
		".html",
		".java",
		".js",
		".jsx",
		".json",
		".jsonc",
		".md",
		".mdx",
		".mjs",
		".mts",
		".py",
		".pyi",
		".rs",
		".sh",
		".sql",
		".toml",
		".ts",
		".tsx",
		".yaml",
		".yml"
	],
	"enabledChecks": {
		"error-boundaries": true,
		"document": true,
		"format": true,
		"import": true,
		"name": true,
		"forward": true,
		"accessibility": true,
		"display-name": true,
		"performance-patterns": true,
		"documented-commands": true,
		"lint": true,
		"knip": true,
		"dead-code": true,
		"type": true,
		"recommend": true,
		"command": true,
		"diff": true,
		"alias": true,
		"security": true,
		"repeated-classes": true,
		"tailwind-canonical": true,
		"regex-dedup": true,
		"ui-patterns": true,
		"ui-recommendations": true,
		"github": true
	},
	"qualityCommands": [
		{
			"name": "Astro type check",
			"command": "node",
			"args": ["scripts/astro-check.mjs"]
		}
	],
	"documentation": {
		"required": {
			"types": true,
			"functions": true,
			"exportedFunctions": true
		}
	},
	"tools": {
		"prettier": "prettier",
		"eslint": "config/node_modules/.bin/eslint",
		"knip": "knip",
		"tsc": "tsc"
	},
	"root": ".",
	"autofix": {
		"document": false
	},
	"security": {
		"runtimeRoots": [],
		"clientRoots": ["src/components"]
	},
	"languageProfiles": ["c", "java", "python"]
}
